# Canonical public origin. Used for same-origin mutation checks.
# Production must be the public HTTPS origin.
APP_URL=http://localhost:3000

# postgres | isolated
# isolated is a local/test adapter only. Do not use it in production.
APP_PERSISTENCE=isolated

# Required when APP_PERSISTENCE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chinachapu

# Long random secret for staff session cookies. Server-only. At least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret

# Comma-separated staff emails. Login also requires a provisioned StaffUser.
STAFF_ALLOWLIST=owner@example.com

# blob | s3 | isolated
# Production on Vercel: blob. Isolated is local/test only.
STORAGE_ADAPTER=isolated
BLOB_READ_WRITE_TOKEN=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BUCKET=chinachapu-public
STORAGE_PRIVATE_BUCKET=chinachapu-private
STORAGE_PUBLIC_BASE_URL=

# Shared Postgres rate-limit rows when APP_PERSISTENCE=postgres.
# memory is used only for isolated/local tests.
RATE_LIMIT_STORE=memory

# Required on hosted deploys. Vercel Cron sends Authorization: Bearer CRON_SECRET.
CRON_SECRET=

# Set true on non-Vercel production hosts so isolated adapters cannot boot.
APP_REQUIRE_HOSTED=false

# Snippe Phase 2. Disabled by default. Never put real keys in client code.
SNIPPE_ENABLED=false
SNIPPE_API_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
# Public HTTPS URL registered with Snippe. Defaults to APP_URL/api/webhooks/snippe
SNIPPE_WEBHOOK_URL=
